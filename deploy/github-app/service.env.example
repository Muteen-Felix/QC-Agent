QC_APP_ID=
QC_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-key.pem
QC_WEBHOOK_SECRET=
# Public repo containing reusable workflows; App does NOT need installation there.
QC_WORKFLOW_REPOSITORY=Muteen-Felix/QC-Agent
# Published SHA40 containing ghcr_username support.
QC_WORKFLOW_REF=
# Published, digest-pinned image used by the SUT Actions workflows.
QC_IMAGE=
QC_QA_OWNER=@MinhDuc-IT
# Only if SUT uses a private GHCR image: username for SUT's GHCR_PULL_TOKEN.
GHCR_USERNAME=MinhDuc-IT
QC_ONBOARD_DB=/data/onboarding.sqlite
