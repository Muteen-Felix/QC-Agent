{
  "task_id": "t-003",
  "plan_id": "plan-poc-001",
  "run_id": "r-deepeval",
  "capability": "llmapp.eval",
  "lane": "gate",
  "intent": "Đánh giá tóm tắt bằng metric tất định và G-Eval advisory",
  "target": {
    "kind": "llm_app",
    "base_url": "http://127.0.0.1:8000"
  },
  "inputs": {
    "outputs_path": "tests/fixtures/outputs_collect.json",
    "judge_config": {
      "provider": "openai",
      "model": "gemini-3.5-flash-lite",
      "fallback_provider": "gemini",
      "fallback_model": "gemini-3.5-flash-lite"
    },
    "sut_model": "stub-rule-v1",
    "metrics": [
      {
        "name": "summary_not_empty",
        "kind": "not_empty",
        "field": "actual_output"
      },
      {
        "name": "summary_shorter_than_body",
        "kind": "shorter_than",
        "field": "actual_output",
        "than": "input"
      },
      {
        "name": "summary_json_valid",
        "kind": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "input",
            "actual_output"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+$"
            },
            "input": {
              "type": "string",
              "minLength": 1
            },
            "actual_output": {
              "type": "string"
            }
          }
        }
      }
    ],
    "geval": {
      "name": "giu_y_chinh",
      "criteria": "Ban tom tat giu lai cac y chinh.",
      "baseline": 0.78
    }
  },
  "oracle": {
    "kind": "checks",
    "required": [
      "summary_not_empty",
      "summary_shorter_than_body",
      "summary_json_valid"
    ]
  },
  "expected_result_kind": "verdict",
  "budget": {
    "wallclock_s": 180,
    "tokens": 50000,
    "usd": 0.5
  },
  "determinism": {
    "seed": null,
    "replayable": true
  },
  "sut_identity_ref": "sut-poc",
  "evidence_required": [
    "raw_output",
    "stdout"
  ],
  "retry": {
    "max": 1,
    "on": [
      "error"
    ]
  }
}
