APP_BASE_URL=http://127.0.0.1:8686
QC_RUNS_DIR=runs
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=
QC_JUDGE_PROVIDER=openai
QC_JUDGE_FALLBACK_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
QC_JUDGE_MODEL=
QC_JUDGE_FALLBACK_MODEL=gemini-3.5-flash-lite
QC_DEEPEVAL_PYTHON=
QC_REPLAY_MIDSCENE=
QC_BUGS=
QC_LATENCY_MS=
QC_LONG_ID_LEN=
# LLM (Ground-Truth generator, Diff Agent). Khoá chỉ đọc bằng os.environ lúc gọi, không vào Settings/log. Test không bao giờ dùng khoá thật.
ANTHROPIC_API_KEY=
# Tuỳ chọn: để trống = https://api.anthropic.com. Test trỏ vào fake server.
ANTHROPIC_BASE_URL=
# Jira Cloud (chỉ dùng khi bật đồng bộ finding Low; không commit giá trị thật)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Model quyết định provider: `gemini-*` -> Gemini (GEMINI_API_KEY), còn lại -> Claude (ANTHROPIC_API_KEY).
QC_GT_MODEL=gemini-3.8-flash
QC_SELECTOR_MODEL=gemini-3.5-flash-lite
QC_LLM_TIMEOUT_S=120
# QC_GT_MODEL=claude-sonnet-5
# QC_SELECTOR_MODEL=claude-haiku-4-5-20251001
# QC_LLM_TIMEOUT_S=120
# --- Gemini (free tier ~5-15 RPM). Ví dụ: QC_GT_MODEL=gemini-3.6-flash  QC_SELECTOR_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY (ở trên) đọc bằng os.environ lúc gọi. GEMINI_BASE_URL tuỳ chọn (test trỏ vào fake).
# Chỉ áp dụng cho Gemini: thử lại (exponential backoff + jitter, tôn trọng Retry-After/retryDelay) khi 429/5xx/lỗi mạng;
# giãn cách tối thiểu giữa hai request (0 = tắt; 12 ≈ 5 RPM, 6 ≈ 10 RPM); model dự phòng khi 404/hết quota ngày/hết lượt retry.
QC_LLM_MAX_RETRIES=5
QC_LLM_MIN_INTERVAL_S=0
QC_LLM_FALLBACK_MODELS=
# Tuỳ chọn: minimal|low|medium|high (Gemini 3). Trống = mặc định của model.
QC_GEMINI_THINKING_LEVEL=
# --- Ground-Truth AGENT (chỉ Claude; đọc PRD + mã nguồn + OpenAPI đầy đủ qua nhiều lượt). Mã nguồn rời máy: cần được phép (egress `source_code`).
# QC_GT_GENERATOR=single là bộ sinh một lời gọi như cũ; `agent` bật vòng lặp. `gt generate --agent` cũng bật cho một lần chạy.
# QC_GT_GENERATOR=single
# QC_GT_AGENT_MODEL=claude-sonnet-5-5
# QC_GT_AGENT_EFFORT=high
# Ngân sách cứng: hết là dừng và trả bộ dở (không raise): số lượt, USD ước tính (chỉ khi biết giá model), giây tường thời gian, byte mã nguồn được đọc.
# QC_GT_AGENT_MAX_TURNS=40
# QC_GT_AGENT_MAX_COST_USD=3
# QC_GT_AGENT_MAX_WALL_S=1800
# QC_GT_AGENT_MAX_READ_BYTES=3000000
# QC_GT_AGENT_TIMEOUT_S=600
# fallbacks=default (beta server-side-fallback): chuyển sang model dự phòng khi bộ phân loại an toàn từ chối. Tắt nếu API trả 400.
# QC_GT_AGENT_FALLBACKS=true
