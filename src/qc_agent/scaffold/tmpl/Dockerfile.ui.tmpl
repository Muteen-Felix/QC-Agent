# qc-agent:generated — Dockerfile web UI (SPA tĩnh) cho gate: build ra {{output_dir}}/ rồi phục vụ bằng nginx ở cổng 8080.
# Context build = thư mục UI (qc.yml: sut_ui_context). Địa chỉ API đi vào bằng build-arg (qc.yml: sut_ui_build_args), KHÔNG đặt bí mật ở đây.
# `COPY <<` (heredoc) cần BuildKit: `docker build` trên ubuntu-latest đã bật sẵn.
FROM node:{{node_major}}-alpine AS build
WORKDIR /app
COPY package.json {{lockfile}} ./
RUN {{install_cmd}}
COPY . .
{{arg_lines}}
RUN {{pm}} run build

FROM nginx:alpine
COPY <<"NGINX" /etc/nginx/conf.d/default.conf
server {
  listen 8080;
  root /usr/share/nginx/html;
  location / { try_files $uri $uri/ /index.html; }
}
NGINX
COPY --from=build /app/{{output_dir}} /usr/share/nginx/html
