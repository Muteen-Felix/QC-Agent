# qc-agent:generated — gate tự động của repo này. Ghim @<commit SHA> (không @main) và image theo digest.
# Xem docs/usage-ci.md trong repo qc-agent. Bật chặn merge: branch protection yêu cầu job `qc-agent / {{project}}` xanh.
name: qc-gate
on:
  pull_request:
    branches: [{{base_branch}}]
  workflow_dispatch:
    inputs:
      workers:
        description: "vd semgrep,schemathesis — để trống = toàn bộ theo policy"
        type: string
        default: ""

jobs:
  qc:
    permissions:               # quyền TỐI THIỂU; workflow tái sử dụng không xin thêm
      contents: read
      checks: write            # Check Run "qc-agent / {{project}}"
      pull-requests: write     # comment dính trên PR
      packages: read           # kéo image từ GHCR
    uses: {{qc_repo}}/.github/workflows/qc-gate.reusable.yml@{{qc_ref}}
    with:
      project: {{project}}
      image: {{image}}
      workers: ${{ inputs.workers }}   # chạy tay: danh sách worker (rỗng = theo policy); PR: luôn rỗng
{{with_block}}
      # SUT cần database (tuỳ chọn, mặc định KHÔNG bật): bỏ comment và điền khi SUT không khởi động được chỉ bằng sut_env. Xem docs/usage-ci.md, mục "SUT cần database".
      # sut_db_image: <image DB>@sha256:<DIGEST>                   # ghim digest; loại DB do SUT chọn
      # sut_db_env: |                                              # KHÔNG đặt bí mật ở đây
      #   POSTGRES_DB=app
      # sut_db_ready_cmd: pg_isready -h 127.0.0.1 -U app           # exit 0 = DB sẵn sàng (hoặc dùng sut_db_port: "5432")
      # Bí mật đặt ở secret của repo SUT (nhiều dòng KEY=VALUE): SUT_SECRET_ENV cho SUT (DATABASE_URL=...@db:5432/app), SUT_DB_SECRET_ENV chỉ cho container db.
      # SUT đã chạy sẵn ở nơi khác thì khai sut_base_url thay cho cả build/chạy SUT lẫn DB.
    secrets:
      GHCR_PULL_TOKEN: ${{ secrets.GHCR_PULL_TOKEN }}
      SUT_SECRET_ENV: ${{ secrets.SUT_SECRET_ENV }}
      SUT_DB_SECRET_ENV: ${{ secrets.SUT_DB_SECRET_ENV }}
      QC_TEST_USERNAME: ${{ secrets.QC_TEST_USERNAME }}
      QC_TEST_PASSWORD: ${{ secrets.QC_TEST_PASSWORD }}
      qc_read_token: ${{ secrets.QC_READ_TOKEN }}
      QC_API_TOKEN: ${{ secrets.QC_API_TOKEN }}
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      JIRA_BASE_URL: ${{ secrets.JIRA_BASE_URL }}
      JIRA_EMAIL: ${{ secrets.JIRA_EMAIL }}
      JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
